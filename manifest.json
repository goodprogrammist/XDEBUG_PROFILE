{
    "manifest_version": 2,
    "name": "Manage XDEBUG_PROFILE Cookie for Debugging",
    "version": "0.2",

    "description": "Toggle the XDEBUG_PROFILE cookie to trigger the Xdebug profiler on the current site.",
    "homepage_url": "https://github.com/goodprogrammist/XDEBUG_PROFILE",

    "icons": {
        "64": "icons/bug-green-64.png",
        "128": "icons/bug-green-128.png"
    },

    "permissions": [
        "tabs",
        "cookies",
        "storage",
        "<all_urls>"
    ],

    "browser_action": {
        "default_icon": {
            "64": "icons/bug-light-64.png",
            "128": "icons/bug-light-128.png"
        },
        "default_title": "XDEBUG_PROFILE cookie (off)"
    },

    "commands": {
        "_execute_browser_action": {
            "suggested_key": {
                "default": "Alt+Shift+P"
            },
            "description": "Toggle XDEBUG_PROFILE cookie"
        }
    },

    "options_ui": {
        "page": "options.html",
        "browser_style": true
    },

    "browser_specific_settings": {
        "gecko": {
            "id": "XDEBUG_PROFILE_cookie_setup@goodprogrammist.ru",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },

    "background": {
        "scripts": ["cookie_XDEBUG_PROFILE.js"]
    }
}
