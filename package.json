{
  "name": "xdebug-profile-cookie",
  "version": "1.1.0",
  "private": true,
  "description": "Firefox/Chrome addon for Xdebug trigger cookies (debug, profile, trace)",
  "license": "MIT",
  "scripts": {
    "lint": "web-ext lint",
    "build": "web-ext build --overwrite-dest",
    "test": "npm run test:unit && npm run test:chrome",
    "test:chrome": "node --test --test-concurrency=1 tests/chrome.test.js",
    "test:firefox": "npm run build && node --test --test-concurrency=1 tests/firefox.test.js",
    "test:unit": "node --test tests/android-env.test.js"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "selenium-webdriver": "4.49.0",
    "web-ext": "10.7.0"
  }
}
